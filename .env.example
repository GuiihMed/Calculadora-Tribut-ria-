# Chave da API Gemini (mantida exclusivamente no BFF Node; nunca exposta ao navegador)
GEMINI_API_KEY=

# Servidor BFF HTTP (Fastify)
PORT=3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bancos SQLite locais
RTC_OFICIAL_DB_PATH=./data/rtc-oficial.db
WORKSPACE_DB_PATH=./data/workspace.db

# Conectores opcionais para os serviços oficiais da Receita Federal (fail-closed quando configurados)
RTC_REGIME_REGULAR_URL=
RTC_SIMPLES_URL=
DANFSE_SERVICE_URL=
DANFSE_WASM_PATH=
DANFSE_WASM_EXEC_JS_PATH=
