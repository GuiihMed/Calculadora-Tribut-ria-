{
  "name": "calculadora-rtc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Copiloto Fiscal & Calculadora da Reforma Tributaria (LC 214/2025 e NT 2026.005)",
  "scripts": {
    "db:bootstrap": "tsx scripts/bootstrap-rfb-db.ts",
    "dev": "tsx watch src/server/server.ts & vite",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@google/genai": "^3.4.0",
    "better-sqlite3": "^13.2.0",
    "csv-parse": "^5.6.0",
    "decimal.js": "^10.5.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.0.8",
    "fastify": "^5.12.8",
    "lucide-react": "^0.511.0",
    "pdfkit": "^0.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
